import re
import calendar


VALID_ORIGINS = ["CLT", "ATL"]


# These patterns check whether each field is in the correct format.
year_pattern = re.compile(r"^\d{4}$")
month_pattern = re.compile(r"^(0?[1-9]|1[0-2])$")
day_pattern = re.compile(r"^(0?[1-9]|[12][0-9]|3[01])$")
carrier_pattern = re.compile(r"^[A-Z]{2}$")
airport_pattern = re.compile(r"^[A-Z0-9]{3,4}$")
delay_pattern = re.compile(r"^-?\d{1,3}$")
cancelled_pattern = re.compile(r"^[01]$")


def valid_day(year, month, day):
    year = int(year)
    month = int(month)
    day = int(day)

    # This checks the actual number of days in each month.
    days_in_month = calendar.monthrange(year, month)[1]
    return day <= days_in_month


def validate_row(fields, line_num, raw_line, log_file):
    # Each row should have exactly 9 fields.
    if len(fields) != 9:
        log_file.write(f"Line {line_num}: Incorrect number of fields\nRaw data: {raw_line}\n\n")
        return False

    year, month, day, carrier, origin, dest, dep_delay, arr_delay, cancelled = fields

    # If a field is invalid, the row is written to the error log.
    if not year_pattern.match(year):
        log_file.write(f"Line {line_num}: Invalid year\nRaw data: {raw_line}\n\n")
        return False

    if not month_pattern.match(month):
        log_file.write(f"Line {line_num}: Invalid month\nRaw data: {raw_line}\n\n")
        return False

    if not day_pattern.match(day) or not valid_day(year, month, day):
        log_file.write(f"Line {line_num}: Invalid day\nRaw data: {raw_line}\n\n")
        return False

    if not carrier_pattern.match(carrier):
        log_file.write(f"Line {line_num}: Invalid carrier\nRaw data: {raw_line}\n\n")
        return False

    if not airport_pattern.match(origin):
        log_file.write(f"Line {line_num}: Invalid origin\nRaw data: {raw_line}\n\n")
        return False

    if not airport_pattern.match(dest):
        log_file.write(f"Line {line_num}: Invalid destination\nRaw data: {raw_line}\n\n")
        return False

    # Delay values can be blank, but if filled in they should be valid numbers.
    if dep_delay != "" and not delay_pattern.match(dep_delay):
        log_file.write(f"Line {line_num}: Invalid departure delay\nRaw data: {raw_line}\n\n")
        return False

    if arr_delay != "" and not delay_pattern.match(arr_delay):
        log_file.write(f"Line {line_num}: Invalid arrival delay\nRaw data: {raw_line}\n\n")
        return False

    if not cancelled_pattern.match(cancelled):
        log_file.write(f"Line {line_num}: Invalid cancelled value\nRaw data: {raw_line}\n\n")
        return False

    return True


def process_file():
    valid_rows = []

    # This reads the airport file and creates the error log.
    with open("airport_data1.txt", "r") as file, open("error_log.txt", "w") as log:
        for line_num, line in enumerate(file, start=1):
            line = line.strip()

            # The header row is skipped.
            if line_num == 1:
                continue

            fields = line.split(",")

            # Only valid rows are saved for sorting and analysis.
            if validate_row(fields, line_num, line, log):
                valid_rows.append(fields)

    return valid_rows


def sort_data(data, choice):
    # This sorts the data based on the user's menu choice.
    if choice == "1":
        return sorted(data, key=lambda row: row[4])
    elif choice == "2":
        return sorted(data, key=lambda row: row[5])
    elif choice == "3":
        return sorted(data, key=lambda row: (row[4], row[5]))
    elif choice == "4":
        return sorted(data, key=lambda row: int(row[1]))
    else:
        return data


def is_delayed(row):
    # Arrival delay of 15 minutes or more counts as delayed.
    if row[7] == "":
        return False
    return int(row[7]) >= 15


def calculate_stats(data, group_index):
    stats = {}

    for row in data:
        group_name = row[group_index]

        # Airport analysis only compares CLT and ATL as origins.
        if group_index == 4 and group_name not in VALID_ORIGINS:
            continue

        cancelled = int(row[8]) == 1
        delayed = is_delayed(row)

        if group_name not in stats:
            stats[group_name] = {
                "total": 0,
                "cancelled": 0,
                "delayed": 0,
                "cancelled_or_delayed": 0
            }

        stats[group_name]["total"] += 1

        if cancelled:
            stats[group_name]["cancelled"] += 1

        if delayed:
            stats[group_name]["delayed"] += 1

        if cancelled or delayed:
            stats[group_name]["cancelled_or_delayed"] += 1

    return stats


def print_stats(stats, title, stat_type):
    print(f"\n--- {title} ---")

    best_name = None
    best_percent = None

    # This prints the count and percentage for the selected analysis.
    for name, values in stats.items():
        total = values["total"]
        count = values[stat_type]
        percent = count / total * 100

        print(f"\n{name}")
        print(f"Total flights: {total}")
        print(f"{stat_type.replace('_', ' ').title()}: {count} ({percent:.2f}%)")

        if best_percent is None or percent < best_percent:
            best_percent = percent
            best_name = name

    print(f"\nBest overall: {best_name} with {best_percent:.2f}% {stat_type.replace('_', ' ')} flights.")


def stats_menu(data):
    while True:
        print("\nStatistical Analysis Options:")
        print("1 - Airport cancellation analysis")
        print("2 - Airport delay analysis")
        print("3 - Airport cancelled or delayed analysis")
        print("4 - Airline cancellation analysis")
        print("5 - Airline delay analysis")
        print("6 - Airline cancelled or delayed analysis")
        print("0 - Return to main menu")

        choice = input("\nEnter choice: ")

        # The user chooses whether to analyze airports or airlines.
        if choice == "1":
            print_stats(calculate_stats(data, 4), "AIRPORT CANCELLATION ANALYSIS", "cancelled")
        elif choice == "2":
            print_stats(calculate_stats(data, 4), "AIRPORT DELAY ANALYSIS", "delayed")
        elif choice == "3":
            print_stats(calculate_stats(data, 4), "AIRPORT CANCELLED OR DELAYED ANALYSIS", "cancelled_or_delayed")
        elif choice == "4":
            print_stats(calculate_stats(data, 3), "AIRLINE CANCELLATION ANALYSIS", "cancelled")
        elif choice == "5":
            print_stats(calculate_stats(data, 3), "AIRLINE DELAY ANALYSIS", "delayed")
        elif choice == "6":
            print_stats(calculate_stats(data, 3), "AIRLINE CANCELLED OR DELAYED ANALYSIS", "cancelled_or_delayed")
        elif choice == "0":
            break
        else:
            print("Invalid choice. Please try again.")


def average_arrival_delay_by_airport(data, airport):
    total = 0
    count = 0

    # Blank arrival delays are skipped so they do not affect the average.
    for row in data:
        if row[4] == airport and row[7] != "":
            total += int(row[7])
            count += 1

    return total / count if count > 0 else 0


def average_departure_delay_by_airport(data, airport):
    total = 0
    count = 0

    # Blank departure delays are skipped so they do not affect the average.
    for row in data:
        if row[4] == airport and row[6] != "":
            total += int(row[6])
            count += 1

    return total / count if count > 0 else 0


def average_arrival_delay(data):
    clt_avg = average_arrival_delay_by_airport(data, "CLT")
    atl_avg = average_arrival_delay_by_airport(data, "ATL")

    print(f"\nAverage Arrival Delay:")
    print(f"CLT: {clt_avg:.2f} minutes")
    print(f"ATL: {atl_avg:.2f} minutes")


def average_departure_delay(data):
    clt_avg = average_departure_delay_by_airport(data, "CLT")
    atl_avg = average_departure_delay_by_airport(data, "ATL")

    print(f"\nAverage Departure Delay:")
    print(f"CLT: {clt_avg:.2f} minutes")
    print(f"ATL: {atl_avg:.2f} minutes")


def main():
    data = process_file()

    print(f"\nLoaded {len(data)} valid rows.")
    print("Error log created as error_log.txt.\n")

    while True:
        print("\nMain Menu:")
        print("1 - Sort Data")
        print("2 - Statistical Analysis")
        print("3 - Avg Arrival Delay (CLT vs ATL)")
        print("4 - Avg Departure Delay (CLT vs ATL)")
        print("5 - Avg Arrival Delay (CLT only)")
        print("6 - Avg Departure Delay (CLT only)")
        print("7 - Avg Arrival Delay (ATL only)")
        print("8 - Avg Departure Delay (ATL only)")
        print("0 - Exit")

        choice = input("\nEnter choice: ")

        if choice == "1":
            print("\nSort options:")
            print("1 - Origin")
            print("2 - Destination")
            print("3 - Origin then Destination")
            print("4 - Month")
            print("0 - No sorting")

            sort_choice = input("\nEnter choice: ")
            sorted_data = sort_data(data, sort_choice)

            print("\n--- RESULTS ---")
            for row in sorted_data:
                print(row)

        elif choice == "2":
            stats_menu(data)

        elif choice == "3":
            average_arrival_delay(data)

        elif choice == "4":
            average_departure_delay(data)

        elif choice == "5":
            print(f"\nCLT Arrival Avg: {average_arrival_delay_by_airport(data, 'CLT'):.2f} minutes")

        elif choice == "6":
            print(f"\nCLT Departure Avg: {average_departure_delay_by_airport(data, 'CLT'):.2f} minutes")

        elif choice == "7":
            print(f"\nATL Arrival Avg: {average_arrival_delay_by_airport(data, 'ATL'):.2f} minutes")

        elif choice == "8":
            print(f"\nATL Departure Avg: {average_departure_delay_by_airport(data, 'ATL'):.2f} minutes")

        elif choice == "0":
            print("\nExiting program.")
            break

        else:
            print("Invalid choice. Try again.")


if __name__ == "__main__":
    main()
